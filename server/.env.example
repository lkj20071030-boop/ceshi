# Copy to server/.env. Keep API keys only on the backend.
PORT=8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_ENABLED=true
LLM_TIMEOUT_MS=20000
# 生成完整教学包耗时较长；异步提问任务会轮询结果，这里可放宽到 90 秒。
DEEPSEEK_TIMEOUT_MS=90000
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=3000
